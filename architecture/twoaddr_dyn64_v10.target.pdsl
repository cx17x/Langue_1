// twoaddr_dyn64_v10: dynamic tagged 64-bit, 2-operand ISA, fixed 4-byte instructions
architecture twoaddr_dyn64_v10 {

	/*
		Variant requirements (v10):
		  - typing: dynamic (values are 64-bit tagged)
		  - instruction format: two-address (dst = dst op src)
		  - memory banks: code + data
		  - MVP: add + mov + li + hlt

		Tagged Value (TV), 64-bit:
		  TV[63:56] = tag
		  TV[55:0]  = payload

		Tags (same idea as stackdyn64):
		  TAG_BOOL = 0x01  => 0x0100000000000000
		  TAG_INT  = 0x02  => 0x0200000000000000

		For MVP:
		  - li loads a TAG_INT from imm16 (sign-extended to 56-bit payload)
		  - add/sub assume numeric tags (BOOL/INT/UINT/CHAR), decode payload as signed, pack TAG_INT
	*/

	registers:
		storage ip [32];       // instruction pointer (byte address in CODE)
		storage status [32];   // 0 = OK, non-zero = trap

		// flags
		storage zf [32];       // zero flag
		storage sf [32];       // sign flag

		// 64-bit storages for tagged values
		storage r0st [64];
		storage r1st [64];
		storage r2st [64];
		storage r3st [64];
		storage r4st [64];
		storage r5st [64];
		storage r6st [64];
		storage r7st [64];

		// expose architectural register names for "register" operand encoding
		view r0 = r0st;
		view r1 = r1st;
		view r2 = r2st;
		view r3 = r3st;
		view r4 = r4st;
		view r5 = r5st;
		view r6 = r6st;
		view r7 = r7st;

		// temporaries
		storage t0 [64];
		storage t1 [64];
		storage t2 [64];
		storage t3 [64];

		// IO
		storage ioport [8];
		storage rin [8];
		storage rout [8];

	memory:
		range code [0x0000 .. 0xffff] {
			cell = 8;
			endianess = little-endian;
			granularity = 1;
		}

		range dataMem [0x0000 .. 0xffff] {
			cell = 8;
			endianess = little-endian;
			granularity = 1;
		}

instructions:

    // ---- encodings ----
    encode reg4 field = register {
        r0 = 0000,
        r1 = 0001,
        r2 = 0010,
        r3 = 0011,
        r4 = 0100,
        r5 = 0101,
        r6 = 0110,
        r7 = 0111
    };

    encode imm16 field = immediate [16];

    // ---- control ----
    // 4 bytes: opcode(1) + 24 bits padding
    instruction nop = { 0000 0000, 0000 0000 0000 0000 0000 0000 } {
        ip = ip + 4;
    };

    instruction hlt = { 0000 0001, 0000 0000 0000 0000 0000 0000 } {
        // stop execution
    };

    // ---- moves / immediates ----
    // mov dst, src : opcode(1) + dst(4) + src(4) + 16 bits padding
    instruction mov = { 0010 0000, reg4 as dst, reg4 as src, 0000 0000 0000 0000 } {
        dst = src;
        ip = ip + 4;
    };

    // li dst, imm16 : opcode(1) + dst(4) + pad4(0000) + imm16(2 bytes)
    instruction li = { 0010 0001, reg4 as dst, 0000, imm16 as imm } {
        // sign-extend 16 -> 64
        t0 = imm;
        t0 = t0 ^ 0x8000;
        t0 = t0 - 0x8000;

        // pack TAG_INT (payload 56-bit)
        t0 = 0x0200000000000000 | (t0 & 0x00ffffffffffffff);
        dst = t0;

        ip = ip + 4;
    };

    // ---- arithmetic ----
    instruction add = { 0100 0000, reg4 as dst, reg4 as src, 0000 0000 0000 0000 } {
        t0 = src;
        t1 = dst;

        // check src tag
        t2 = (t0 >> 56) & 0xff;
        t3 = ((t2 == 0x01) | (t2 == 0x02) | (t2 == 0x03) | (t2 == 0x04));
        if t3 != 0 then ip = ip; else { status = 1; }

        // check dst tag
        t2 = (t1 >> 56) & 0xff;
        t3 = ((t2 == 0x01) | (t2 == 0x02) | (t2 == 0x03) | (t2 == 0x04));
        if t3 != 0 then ip = ip; else { status = 1; }

        // decode signed 56-bit payloads
        t0 = t0 & 0x00ffffffffffffff;
        t0 = (t0 ^ 0x0080000000000000) - 0x0080000000000000;

        t1 = t1 & 0x00ffffffffffffff;
        t1 = (t1 ^ 0x0080000000000000) - 0x0080000000000000;

        // add and repack TAG_INT
        t1 = t1 + t0;
        t1 = 0x0200000000000000 | (t1 & 0x00ffffffffffffff);

        dst = t1;
        ip = ip + 4;
    };

    // sub dst, src : dst = dst - src (added)
    instruction sub = { 0100 0001, reg4 as dst, reg4 as src, 0000 0000 0000 0000 } {
        t0 = src;
        t1 = dst;

        // check src tag
        t2 = (t0 >> 56) & 0xff;
        t3 = ((t2 == 0x01) | (t2 == 0x02) | (t2 == 0x03) | (t2 == 0x04));
        if t3 != 0 then ip = ip; else { status = 1; }

        // check dst tag
        t2 = (t1 >> 56) & 0xff;
        t3 = ((t2 == 0x01) | (t2 == 0x02) | (t2 == 0x03) | (t2 == 0x04));
        if t3 != 0 then ip = ip; else { status = 1; }

        // decode signed 56-bit payloads
        t0 = t0 & 0x00ffffffffffffff;
        t0 = (t0 ^ 0x0080000000000000) - 0x0080000000000000;

        t1 = t1 & 0x00ffffffffffffff;
        t1 = (t1 ^ 0x0080000000000000) - 0x0080000000000000;

        // subtract and repack TAG_INT
        t1 = t1 - t0;
        t1 = 0x0200000000000000 | (t1 & 0x00ffffffffffffff);

        dst = t1;
        ip = ip + 4;
    };

    // ---- compare + flags ----
    // cmp a, b : sets zf/sf according to (a - b) on signed payloads
    instruction cmp = { 0101 0000, reg4 as a, reg4 as b, 0000 0000 0000 0000 } {
        // decode a
        t0 = a & 0x00ffffffffffffff;
        t0 = (t0 ^ 0x0080000000000000) - 0x0080000000000000;

        // decode b
        t1 = b & 0x00ffffffffffffff;
        t1 = (t1 ^ 0x0080000000000000) - 0x0080000000000000;

        // diff = a - b
        t2 = t0 - t1;

        // flags
        if t2 == 0 then zf = 1; else zf = 0;
        if t2 < 0 then sf = 1; else sf = 0;

        ip = ip + 4;
    };

    // ---- jumps ----
    // encoding: opcode(1) + pad(1) + imm16(2)
    instruction jmp = { 0111 0000, 0000 0000, imm16 as target } {
        ip = target;
    };

    instruction jz = { 0111 0001, 0000 0000, imm16 as target } {
        if zf != 0 then ip = target; else ip = ip + 4;
    };

    instruction jnz = { 0111 0010, 0000 0000, imm16 as target } {
        if zf == 0 then ip = target; else ip = ip + 4;
    };

    // jn: jump if negative (sf != 0) (added)
    instruction jn = { 0111 0011, 0000 0000, imm16 as target } {
        if sf != 0 then ip = target; else ip = ip + 4;
    };

    // ---- output decimal ----
    // outd src : print signed payload as decimal ASCII to rout, then '\n'
    // NOTE: decimal printing supports 0..65535 (and negatives in that range)
    instruction outd = { 0110 0010, reg4 as src, 0000, 0000 0000 0000 0000 } {
        // extract signed payload (56-bit signed)
        t0 = src;
        t0 = t0 & 0x00ffffffffffffff;
        t0 = (t0 ^ 0x0080000000000000) - 0x0080000000000000;  // sign-extend 56 -> 64

        // handle sign
        t1 = 0;                  // neg flag
        if t0 < 0 then {
            t1 = 1;
            t0 = 0 - t0;         // abs
        }

        // print '-'
        if t1 != 0 then {
            rout = 45;           // '-'
        }

        // Special case: 0
        if t0 == 0 then {
            rout = 48;           // '0'
            rout = 10;           // '\n'
            ip = ip + 4;
        } else {
            // print number (0..65535)
            // d4 = t0 / 10000; t0 %= 10000
            t2 = t0 / 10000;
            t0 = t0 - (t2 * 10000);

            // d3 = t0 / 1000; t0 %= 1000
            t3 = t0 / 1000;
            t0 = t0 - (t3 * 1000);

            // started flag (reuse t1)
            t1 = 0;

            // print d4 if nonzero
            if t2 != 0 then {
                rout = t2 + 48;
                t1 = 1;
            }

            // print d3 if started or nonzero
            if (t1 != 0) | (t3 != 0) then {
                rout = t3 + 48;
                t1 = 1;
            }

            // d2 = t0 / 100; t0 %= 100
            t2 = t0 / 100;
            t0 = t0 - (t2 * 100);

            if (t1 != 0) | (t2 != 0) then {
                rout = t2 + 48;
                t1 = 1;
            }

            // d1 = t0 / 10; t0 %= 10
            t2 = t0 / 10;
            t0 = t0 - (t2 * 10);

            if (t1 != 0) | (t2 != 0) then {
                rout = t2 + 48;
                t1 = 1;
            }

            // last digit d0 = t0
            rout = t0 + 48;

            // newline
            rout = 10;

            ip = ip + 4;
        }
    };

    mnemonics:
        format plain0 is "";
        format plain1 is "{1}";
        format plain2 is "{1}, {2}";

        mnemonic nop() plain0;
        mnemonic hlt() plain0;

        mnemonic mov(dst, src) plain2;
        mnemonic li(dst, imm)  plain2;
        mnemonic add(dst, src) plain2;
        mnemonic sub(dst, src) plain2;

        mnemonic cmp(a, b)     plain2;

        mnemonic jmp(target)   plain1;
        mnemonic jz(target)    plain1;
        mnemonic jnz(target)   plain1;
        mnemonic jn(target)    plain1;

        mnemonic outd(src)     plain1;

}
